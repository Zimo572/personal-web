---
interface Props {
  title: string;
  description: string;
  href: string;
  duration?: string;
  image?: string;
}

const { title, description, href, duration, image } = Astro.props;
---

<!-- A row, not a card. The podcast list is scanned top to bottom, so the
     thumbnail sits left and the text runs beside it. -->
<a
  href={href}
  data-search={`${title} ${description}`.toLowerCase()}
  class="group flex gap-5 border-b border-line py-6 last:border-0"
>
  {
    image ? (
      <img
        src={image}
        alt=""
        width="112"
        height="112"
        class="h-20 w-20 shrink-0 rounded-md object-cover sm:h-28 sm:w-28"
      />
    ) : (
      <div class="h-20 w-20 shrink-0 rounded-md bg-navy sm:h-28 sm:w-28" />
    )
  }

  <div class="min-w-0">
    <h2 class="font-semibold text-navy group-hover:underline">
      {title}
    </h2>

    <p class="mt-1.5 text-sm text-muted">{description}</p>

    {
      duration && (
        <p class="mt-3 text-xs font-semibold text-blue">{duration}</p>
      )
    }
  </div>
</a>